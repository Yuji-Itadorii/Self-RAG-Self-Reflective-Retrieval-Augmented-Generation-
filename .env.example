# Self-RAG Configuration
# Copy this file to .env and fill in your values

# --- API Keys (required) ---
SELFRAG_OPENAI_API_KEY=sk-your-openai-api-key-here
SELFRAG_LANGSMITH_API_KEY=ls-your-langsmith-api-key-here

# --- LLM Models ---
SELFRAG_GENERATION_MODEL=gpt-4o
SELFRAG_CRITIQUE_MODEL=gpt-4o-mini
SELFRAG_EMBEDDING_MODEL=text-embedding-3-small
SELFRAG_EMBEDDING_DIMENSION=1536

# --- Retrieval ---
SELFRAG_RETRIEVAL_TOP_K=5

# --- Grading Thresholds ---
SELFRAG_RELEVANCE_THRESHOLD=0.7
SELFRAG_SUPPORT_THRESHOLD=0.7
SELFRAG_USEFULNESS_THRESHOLD=0.5

# --- Loop Caps ---
SELFRAG_MAX_REVISIONS=2
SELFRAG_MAX_REWRITES=2

# --- Chunking ---
SELFRAG_CHUNK_SIZE=1000
SELFRAG_CHUNK_OVERLAP=200

# --- Database ---
SELFRAG_DATABASE_URL=postgresql://selfrag:selfrag@localhost:5432/selfrag
SELFRAG_COLLECTION_NAME=selfrag_documents

# --- Observability ---
SELFRAG_LANGSMITH_PROJECT=self-rag
LANGCHAIN_TRACING_V2=false
